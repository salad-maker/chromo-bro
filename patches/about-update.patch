+struct ChromoUpdateStatus {
+  VersionUpdater::Status status = VersionUpdater::DISABLED;
+  int progress = 0;
+  std::u16string message;
+
+  bool operator==(const ChromoUpdateStatus&) const = default;
+};
+
+ChromoUpdateStatus ReadChromoUpdateStatus() {
+  base::FilePath exe_dir;
+  if (!base::PathService::Get(base::DIR_EXE, &exe_dir)) {
+    return {};
+  }
+  const base::FilePath root = exe_dir.DirName();
+  if (!base::PathExists(root.AppendASCII("runtime").AppendASCII("client.json"))) {
+    return {};
+  }
+  base::File file(root.AppendASCII(".chromo").AppendASCII("about-update.json"),
+                  base::File::FLAG_OPEN | base::File::FLAG_READ |
+                      base::File::FLAG_WIN_SHARE_DELETE);
+  base::File::Info info;
+  if (!file.IsValid() || !file.GetInfo(&info) || info.size <= 0 || info.size > 4096) {
+    return {VersionUpdater::DEFERRED, 0, u"Waiting for Chromo to check for updates."};
+  }
+  std::string contents(info.size, '\0');
+  if (!file.ReadAtCurrentPosAndCheck(base::as_writable_byte_span(contents))) {
+    return {};
+  }
+  auto state = base::JSONReader::ReadDict(contents, base::JSON_PARSE_RFC);
+  if (!state || state->FindInt("schema") != 1) {
+    return {};
+  }
+  const std::string* phase = state->FindString("phase");
+  if (!phase) {
+    return {};
+  }
+  if (*phase == "checking" || *phase == "updating") {
+    const int pid = state->FindInt("pid").value_or(0);
+    const base::Process process = pid > 0 ? base::Process::Open(pid) : base::Process();
+    if (!process.IsValid() || !process.IsRunning() ||
+        process.CreationTime() > info.last_modified) {
+      return {VersionUpdater::DEFERRED, 0,
+              u"The Chromo update was interrupted. Run chromo update to retry."};
+    }
+    if (*phase == "checking") {
+      return {VersionUpdater::CHECKING, 0, {}};
+    }
+    const int progress = state->FindInt("progress").value_or(0);
+    return {VersionUpdater::UPDATING,
+            progress > 0 && progress <= 100 ? progress : 0, {}};
+  }
+  if (*phase == "current" &&
+      base::Time::Now() - info.last_modified <= base::Hours(48)) {
+    return {VersionUpdater::UPDATED, 0, {}};
+  }
+  if (*phase == "ready") {
+    return {VersionUpdater::DEFERRED, 0,
+            u"Update ready. Close Chromium and open Chromo to install it."};
+  }
+  if (*phase == "failed") {
+    return {VersionUpdater::FAILED_DOWNLOAD, 0,
+            u"Chromo could not update Chromium. Run chromo status for details."};
+  }
+  return {VersionUpdater::DEFERRED, 0, u"Waiting for Chromo to check for updates."};
+}
+#endif  // BUILDFLAG(IS_WIN)
